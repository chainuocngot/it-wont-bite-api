// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TodoStatus {
  Todo
  InProgress
  Completed
  Overdue
  Cancelled
}

enum TodoLabelColor {
  Blue
  Red
  Yellow
  Green
  Purple
  Pink
  Orange
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  pwd       String
  name      String
  bio       String?
  username  String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  todos          Todo[]
  refreshTokens  RefreshToken[]
  discordWebhook DiscordWebhook?

  @@map("users")
}

model Todo {
  id                Int        @id @default(autoincrement())
  userId            Int        @map("user_id")
  title             String
  status            TodoStatus
  description       String?
  dueAt             DateTime?  @map("due_at")
  remindAt          DateTime?  @map("remind_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  isFav             Boolean    @default(false) @map("is_fav")
  removeFromTodayAt DateTime?  @map("remove_from_today_at")

  user   User        @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: Cascade)
  labels TodoLabel[]

  @@index([userId])
  @@index([status, dueAt])
  @@index([removeFromTodayAt])
  @@map("todos")
}

model TodoLabel {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  color     TodoLabelColor @unique
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  todos Todo[]

  @@map("todo_labels")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("refresh_tokens")
}

model DiscordWebhook {
  id         Int      @id @default(autoincrement())
  webhookUrl String
  name       String? // "Server X - #alerts"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: Cascade)

  @@index([userId])
}
